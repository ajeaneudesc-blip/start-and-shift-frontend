{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.startshift.tg",
        "EXPO_PUBLIC_WS_URL": "wss://api.startshift.tg/ws",
        "EXPO_PUBLIC_BACKOFFICE_URL": "https://backoffice.startshift.tg"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.startshift.tg",
        "EXPO_PUBLIC_WS_URL": "wss://api.startshift.tg/ws",
        "EXPO_PUBLIC_BACKOFFICE_URL": "https://backoffice.startshift.tg"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
