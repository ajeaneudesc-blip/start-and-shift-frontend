# API START AND SHIFT — le backend écoute sur le port 3000 (src/config.ts).
#
# localhost fonctionne pour : le navigateur (npm run web) et un iOS simulator.
# Émulateur Android  → remplacer par http://10.0.2.2:3000
# Téléphone physique → remplacer par l'IP locale du PC, ex. http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Le serveur WebSocket est monté sur le chemin /ws (src/ws/handler.ts).
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws
